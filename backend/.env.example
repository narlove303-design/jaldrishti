# JalDrishti Backend Environment Configuration Template

# Server Port
PORT=4000

# JSON Web Token Secret (Mandatory in production; ephemeral random key generated in dev if omitted)
JWT_SECRET=your_production_256_bit_random_secret_here
JWT_EXPIRES_IN=24h

# Whitelisted Frontend Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Database Configuration (Default: embedded SQLite via node:sqlite in WAL mode)
DB_TYPE=sqlite
DATABASE_PATH=./data/jaldrishti.db

# Fluid Mechanics & SCADA Simulation Engine
SIMULATION_MODE=true
SIMULATION_INTERVAL_MS=3000

# MQTT Gateway Configuration (For Future PLC / IoT Hardware Ingestion)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=jaldrishti_telemetry_engine
MQTT_TOPIC_PUMP=jaldrishti/station/p01/telemetry
MQTT_TOPIC_VALVES=jaldrishti/junction/j01/valves
