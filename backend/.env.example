# JalDrishti Backend Environment Configuration Template

# Server Port
PORT=4000

# JSON Web Token Secret
JWT_SECRET=jaldrishti_super_secure_telemetry_jwt_secret_key_2026

# Database Type: 'sqlite' (default embedded node:sqlite) or 'postgres'
DB_TYPE=sqlite
DATABASE_URL=sqlite://./data/jaldrishti.db

# MQTT Telemetry Ingestion Broker (For Future Hardware/PLC Gateway)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=jaldrishti_telemetry_engine
MQTT_TOPIC_PUMP=jaldrishti/station/p01/telemetry
MQTT_TOPIC_VALVES=jaldrishti/junction/j01/valves

# Simulation Mode: true runs internal mathematical hydraulic engine
SIMULATION_MODE=true
SIMULATION_INTERVAL_MS=3000
